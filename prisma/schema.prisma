datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TenantType {
  PLATFORM
  SCHOOL
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING_SETUP
}

enum BrandTheme {
  ECOSYSTEM
  MALE
  FEMALE
  COLLEGE
  CLUB
}

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  PARENT
  STAFF
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_ACTIVATION
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EnrollmentStatus {
  ACTIVE
  TRANSFERRED
  GRADUATED
  DROPPED
}

enum LessonType {
  GENERAL
  SPECIALIZED
  PRACTICAL
  OPTIONAL
}

enum DayOfWeek {
  SATURDAY
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

enum CoachType {
  ACADEMIC_COUNSELOR
  DISCIPLINARY
  SPORTS
  CULTURAL
  HEALTH
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  HOURLY
  CONTRACT
}

enum ParentRelationType {
  FATHER
  MOTHER
  LEGAL_GUARDIAN
}

// Phase 3 Enums
enum AttendanceStatus {
  PRESENT
  ABSENT
  TARDY
  EXCUSED_ABSENT
  EXPELLED
}

enum TeacherAttendanceStatus {
  PRESENT
  ABSENT
  LEAVE_AUTHORIZED
  LEAVE_UNAUTHORIZED
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  LATE
  GRADED
  RESUBMIT_REQUIRED
}

enum EventType {
  ACADEMIC
  HOLIDAY
  EXAM
  MEETING
  CULTURAL
  SPORTS
  EXCURSION
}

enum TargetAudience {
  ALL
  STUDENTS
  TEACHERS
  PARENTS
  STAFF
  SPECIFIC_CLASSES
}

enum PollType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  RATING_SCALE
}

enum BookingStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum MatterType {
  POSITIVE
  NEGATIVE
  WARNING
  SUSPENSION
  COUNSELING_REFERRAL
}

// Phase 4 Enums
enum LessonPlanSessionStatus {
  PLANNED
  COMPLETED
  IN_PROGRESS
  CANCELLED
  MAKEUP_REQUIRED
}

enum QuestionType {
  MULTIPLE_CHOICE
  DESCRIPTIVE
  TRUE_FALSE
  FILL_IN_BLANK
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
  OLYMPIAD
}

enum ExamType {
  ONLINE
  PAPER_BASED
  HYBRID
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  RUNNING
  FINISHED
  CANCELLED
}

enum ParticipationStatus {
  IN_PROGRESS
  SUBMITTED
  TIMED_OUT
  ABSENT
}

enum GradeType {
  CLASS_ACTIVITY
  QUIZ
  HOMEWORK_GRADE
  MIDTERM
  FINAL_TERM_1
  FINAL_TERM_2
  CUSTOM
}

model Tenant {
  id           String       @id @default(uuid())
  type         TenantType   @default(SCHOOL)
  name         String
  slug         String       @unique
  subdomain    String?      @unique
  customDomain String?      @unique
  theme        BrandTheme   @default(ECOSYSTEM)
  status       TenantStatus @default(ACTIVE)
  logoUrl      String?
  phone        String?
  email        String?
  address      String?
  settings     Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  users             User[]
  featureFlags      TenantFeatureFlag[]
  auditLogs         AuditLog[]
  tokenFamilies     RefreshTokenFamily[]

  // Phase 2 ERP Relations
  academicYears     AcademicYear[]
  terms             Term[]
  educationalLevels EducationalLevel[]
  studyFields       StudyField[]
  lessons           Lesson[]
  classrooms        Classroom[]
  classEnrollments  ClassEnrollment[]
  classSchedules    ClassSchedule[]
  schoolRoles       SchoolRole[]
  userSchoolRoles   UserSchoolRole[]
  studentProfiles   StudentProfile[]
  teacherProfiles   TeacherProfile[]
  coachProfiles     CoachProfile[]
  staffProfiles     StaffProfile[]
  parentProfiles    ParentProfile[]
  parentLinks       ParentStudentLink[]
  profileBlogs      ProfileBlog[]
  schoolProfile     SchoolProfile?

  // Phase 3 Operations Relations
  studentAttendances  StudentAttendance[]
  teacherAttendances  TeacherAttendance[]
  homeworks           Homework[]
  homeworkSubmissions HomeworkSubmission[]
  schoolEvents        SchoolEvent[]
  polls               Poll[]
  pollVotes           PollVote[]
  parentVisitSlots    ParentVisitSlot[]
  parentVisitBookings ParentVisitBooking[]
  disciplinaryMatters DisciplinaryMatter[]

  // Phase 4 LMS & Exam Relations
  lessonPlans         LessonPlan[]
  questionCategories  QuestionCategory[]
  questions           Question[]
  exams               Exam[]
  examClassrooms      ExamClassroom[]
  examParticipations  ExamParticipation[]
  gradeEntries        GradeEntry[]

  // Phase 5 Relations
  courseMaterials     CourseMaterial[]
  materialClassrooms  MaterialClassroom[]
  chatChannels        ChatChannel[]
  chatChannelMembers  ChatChannelMember[]
  chatMessages        ChatMessage[]

  // Phase 6 Relations
  studentFeeContracts   StudentFeeContract[]
  feeInstallments       FeeInstallment[]
  paymentTransactions   PaymentTransaction[]
  feeReceipts           FeeReceipt[]
  staffPayrollProfiles  StaffPayrollProfile[]
  payrollSlips          PayrollSlip[]
  payrollItems          PayrollItem[]

  @@index([status])
  @@index([createdAt])
}

model User {
  id              String     @id @default(uuid())
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email           String?
  phone           String?
  nationalId      String?
  username        String?
  passwordHash    String
  firstName       String
  lastName        String
  gender          Gender?
  role            UserRole   @default(STUDENT)
  isPlatformAdmin Boolean    @default(false)
  status          UserStatus @default(ACTIVE)
  avatarUrl       String?
  metadata        Json?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tokenFamilies RefreshTokenFamily[]
  auditLogs     AuditLog[]

  // Phase 2 Relations
  userSchoolRoles   UserSchoolRole[]
  studentProfile    StudentProfile?
  teacherProfile    TeacherProfile?
  coachProfile      CoachProfile?
  staffProfile      StaffProfile?
  parentProfile     ParentProfile?
  profileBlogs      ProfileBlog[]
  mentoredClasses   Classroom[]      @relation("ClassMentor")

  // Phase 3 Relations
  recordedStudentAttendances StudentAttendance[]  @relation("RecordedStudentAttendance")
  recordedTeacherAttendances TeacherAttendance[]  @relation("RecordedTeacherAttendance")
  gradedSubmissions          HomeworkSubmission[] @relation("GradedSubmission")
  createdEvents              SchoolEvent[]        @relation("CreatedEvent")
  createdPolls               Poll[]               @relation("CreatedPoll")
  pollVotes                  PollVote[]
  reportedMatters            DisciplinaryMatter[] @relation("ReportedMatter")

  // Phase 4 Relations
  createdQuestions Question[]   @relation("CreatedQuestion")
  recordedGrades   GradeEntry[] @relation("RecordedGrade")

  // Phase 5 Relations
  chatMemberships  ChatChannelMember[]
  sentChatMessages ChatMessage[]        @relation("SentChatMessage")

  // Phase 6 Relations
  paymentTransactions   PaymentTransaction[]  @relation("PayerTransactions")
  issuedFeeReceipts     FeeReceipt[]          @relation("IssuedFeeReceipts")
  staffPayrollProfile   StaffPayrollProfile?
  payrollSlips          PayrollSlip[]         @relation("EmployeePayrollSlips")
  approvedPayrollSlips  PayrollSlip[]         @relation("ApprovedPayrollSlips")

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@unique([tenantId, username])
  @@index([tenantId, role])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model RefreshTokenFamily {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isRevoked     Boolean  @default(false)
  revokedReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tokens RefreshToken[]

  @@index([tenantId, userId])
  @@index([userId, isRevoked])
}

model RefreshToken {
  id        String             @id @default(uuid())
  familyId  String
  family    RefreshTokenFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  tokenHash String             @unique
  isUsed    Boolean            @default(false)
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime           @default(now())

  @@index([familyId, isUsed])
  @@index([expiresAt])
}

model FeatureFlag {
  id             String   @id @default(uuid())
  key            String   @unique
  name           String
  description    String?
  category       String   @default("GENERAL")
  defaultEnabled Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenantOverrides TenantFeatureFlag[]

  @@index([category])
}

model TenantFeatureFlag {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  featureFlagId String
  featureFlag   FeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)
  isEnabled     Boolean
  config        Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([tenantId, featureFlagId])
  @@index([tenantId, isEnabled])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  @@index([tenantId, action])
  @@index([userId, createdAt])
}

// ==========================================
// PHASE 2: CORE ERP & ACADEMIC STRUCTURE
// ==========================================

model AcademicYear {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String    // e.g. "۱۴۰۴-۱۴۰۵"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  terms               Term[]
  classrooms          Classroom[]
  classEnrollments    ClassEnrollment[]
  studentAttendances  StudentAttendance[]
  disciplinaryMatters DisciplinaryMatter[]

  // Phase 4
  lessonPlans         LessonPlan[]
  exams               Exam[]
  gradeEntries        GradeEntry[]

  // Phase 5
  courseMaterials     CourseMaterial[]

  // Phase 6
  studentFeeContracts StudentFeeContract[]

  @@unique([tenantId, name])
  @@index([tenantId, isCurrent])
}

model Term {
  id             String       @id @default(uuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String       // e.g. "نیم‌سال اول", "نیم‌سال دوم", "تابستان"
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  lessonPlans    LessonPlan[]
  exams          Exam[]
  gradeEntries   GradeEntry[]
  courseMaterials CourseMaterial[]

  @@unique([academicYearId, name])
  @@index([tenantId, academicYearId])
}

model EducationalLevel {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String   // e.g. "متوسطه اول", "متوسطه دوم", "کالج"
  code       String   // e.g. "HIGH_SCHOOL_2"
  orderIndex Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  studyFields StudyField[]
  classrooms  Classroom[]
  lessons     Lesson[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId, orderIndex])
}

model StudyField {
  id        String           @id @default(uuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  levelId   String
  level     EducationalLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  name      String           // e.g. "ریاضی و فیزیک", "علوم تجربی", "شبکه و نرم‌افزار"
  code      String           // e.g. "MATH_PHYSICS"
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  classrooms Classroom[]
  lessons    Lesson[]

  @@unique([tenantId, levelId, name])
  @@unique([tenantId, code])
  @@index([tenantId, levelId])
}

model Lesson {
  id          String           @id @default(uuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  levelId     String
  level       EducationalLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  fieldId     String?
  field       StudyField?      @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  name        String           // e.g. "حسابان ۱", "فیزیک پیشرفته", "ادبیات فارسی"
  code        String           // e.g. "CALC-10"
  unitCount   Int              @default(1)
  type        LessonType       @default(GENERAL)
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  schedules          ClassSchedule[]
  studentAttendances StudentAttendance[]
  homeworks          Homework[]

  // Phase 4 Relations
  lessonPlans        LessonPlan[]
  questionCategories QuestionCategory[]
  questions          Question[]
  exams              Exam[]
  gradeEntries       GradeEntry[]

  // Phase 5 Relations
  courseMaterials    CourseMaterial[]

  @@unique([tenantId, code])
  @@index([tenantId, levelId])
}

model Classroom {
  id             String           @id @default(uuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  levelId        String
  level          EducationalLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  fieldId        String?
  field          StudyField?      @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  mentorId       String?
  mentor         User?            @relation("ClassMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  name           String           // e.g. "کلاس دهم ریاضی ۱"
  code           String           // e.g. "CLS-10-M1"
  capacity       Int              @default(30)
  roomNumber     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  enrollments        ClassEnrollment[]
  schedules          ClassSchedule[]
  studentAttendances StudentAttendance[]
  homeworks          Homework[]

  // Phase 4 Relations
  examClassrooms     ExamClassroom[]
  gradeEntries       GradeEntry[]

  // Phase 5 Relations
  materialClassrooms MaterialClassroom[]
  chatChannels       ChatChannel[]

  @@unique([tenantId, academicYearId, name])
  @@unique([tenantId, academicYearId, code])
  @@index([tenantId, academicYearId])
}

model ClassEnrollment {
  id             String           @id @default(uuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classroomId    String
  classroom      Classroom        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  studentId      String
  student        StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime         @default(now())

  @@unique([classroomId, studentId])
  @@index([tenantId, studentId])
  @@index([tenantId, classroomId])
}

model ClassSchedule {
  id          String         @id @default(uuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classroomId String
  classroom   Classroom      @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  dayOfWeek   DayOfWeek
  periodNumber Int           // زنگ ۱، ۲، ۳
  startTime   String         // "08:00"
  endTime     String         // "09:30"
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  studentAttendances StudentAttendance[]

  @@unique([classroomId, dayOfWeek, periodNumber])
  @@index([tenantId, classroomId])
  @@index([tenantId, teacherId])
  @@index([tenantId, dayOfWeek])
}

// ==========================================
// PHASE 2: DYNAMIC RBAC & PERMISSIONS
// ==========================================

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "attendance.write", "grades.manage"
  module      String   // e.g. "ERP_ACADEMIC", "LMS", "FINANCE"
  name        String   // e.g. "ثبت و ویرایش حضور و غیاب"
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([module])
}

model SchoolRole {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String   // e.g. "ناظم پایه دهم", "مشاور تحصیلی", "حسابدار"
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  userRoles   UserSchoolRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model RolePermission {
  id           String     @id @default(uuid())
  schoolRoleId String
  schoolRole   SchoolRole @relation(fields: [schoolRoleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([schoolRoleId, permissionId])
  @@index([schoolRoleId])
}

model UserSchoolRole {
  id           String     @id @default(uuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolRoleId String
  schoolRole   SchoolRole @relation(fields: [schoolRoleId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([tenantId, userId, schoolRoleId])
  @@index([tenantId, userId])
}

// ==========================================
// PHASE 2: MEMBER PROFILES & RELATIONSHIPS
// ==========================================

model StudentProfile {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentCode  String    // شماره دانش‌آموزی
  nationalCode String?   // کد ملی
  fatherName   String?
  birthDate    DateTime?
  address      String?
  medicalNotes String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  enrollments         ClassEnrollment[]
  parentLinks         ParentStudentLink[]
  studentAttendances  StudentAttendance[]
  homeworkSubmissions HomeworkSubmission[]
  parentVisitBookings ParentVisitBooking[]
  disciplinaryMatters DisciplinaryMatter[]

  // Phase 4 Relations
  examParticipations  ExamParticipation[]
  gradeEntries        GradeEntry[]

  // Phase 6 Relations
  feeContracts        StudentFeeContract[]

  @@unique([tenantId, studentCode])
  @@index([tenantId, nationalCode])
}

model TeacherProfile {
  id             String         @id @default(uuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  speciality     String?        // تخصص (e.g. "ریاضیات و هندسه")
  degree         String?        // مدرک تحصیلی (e.g. "کارشناسی ارشد")
  employmentType EmploymentType @default(FULL_TIME)
  bio            String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  schedules          ClassSchedule[]
  teacherAttendances TeacherAttendance[]
  homeworks          Homework[]
  parentVisitSlots   ParentVisitSlot[]

  // Phase 4 Relations
  lessonPlans        LessonPlan[]
  exams              Exam[]
  gradeEntries       GradeEntry[]

  // Phase 5 Relations
  courseMaterials    CourseMaterial[]

  @@index([tenantId])
}

model CoachProfile {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachType CoachType @default(ACADEMIC_COUNSELOR)
  bio       String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId, coachType])
}

model StaffProfile {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  department String?  // e.g. "امور مالی", "امور دفتری"
  jobTitle   String?  // e.g. "مسئول ثبت‌نام"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
}

model ParentProfile {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  occupation  String?  // شغل
  education   String?  // تحصیلات
  workPhone   String?
  homeAddress String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studentLinks        ParentStudentLink[]
  parentVisitBookings ParentVisitBooking[]

  @@index([tenantId])
}

model ParentStudentLink {
  id               String             @id @default(uuid())
  tenantId         String
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentId         String
  parent           ParentProfile      @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId        String
  student          StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  relationType     ParentRelationType @default(FATHER)
  isPrimaryContact Boolean            @default(false)
  createdAt        DateTime           @default(now())

  @@unique([parentId, studentId])
  @@index([tenantId, studentId])
  @@index([tenantId, parentId])
}

// ==========================================
// PHASE 2: PROFILES & SCHOOL BLOG
// ==========================================

model ProfileBlog {
  id            String    @id @default(uuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authorId      String
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title         String
  slug          String
  content       String
  coverImageUrl String?
  isPublished   Boolean   @default(true)
  publishedAt   DateTime? @default(now())
  tags          String[]  @default([])
  viewCount     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, authorId])
  @@index([tenantId, isPublished])
}

model SchoolProfile {
  id             String   @id @default(uuid())
  tenantId       String   @unique
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  motto          String?  // شعار مدرسه
  aboutHtml      String?
  headerImageUrl String?
  socialLinks    Json?
  managerName    String?
  managerMessage String?
  achievements   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ==========================================
// PHASE 3: DAILY ACADEMIC OPERATIONS
// ==========================================

model StudentAttendance {
  id             String           @id @default(uuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classroomId    String
  classroom      Classroom        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  lessonId       String?
  lesson         Lesson?          @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  scheduleId     String?
  schedule       ClassSchedule?   @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  studentId      String
  student        StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date           String           // format: "YYYY-MM-DD" e.g. "2026-09-01"
  periodNumber   Int?             // زنگ کلاسی (null = روزانه کل)
  status         AttendanceStatus @default(PRESENT)
  delayMinutes   Int              @default(0)
  reason         String?          // دلیل غیبت یا تاخیر
  recordedById   String
  recordedBy     User             @relation("RecordedStudentAttendance", fields: [recordedById], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([tenantId, classroomId, studentId, date, periodNumber])
  @@index([tenantId, date, status])
  @@index([tenantId, studentId, date])
  @@index([tenantId, classroomId, date])
}

model TeacherAttendance {
  id           String                  @id @default(uuid())
  tenantId     String
  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacherId    String
  teacher      TeacherProfile          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  date         String                  // format: "YYYY-MM-DD"
  entryTime    String?                 // "07:45"
  exitTime     String?                 // "14:30"
  status       TeacherAttendanceStatus @default(PRESENT)
  notes        String?
  recordedById String?
  recordedBy   User?                   @relation("RecordedTeacherAttendance", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@unique([tenantId, teacherId, date])
  @@index([tenantId, date])
}

model Homework {
  id                   String     @id @default(uuid())
  tenantId             String
  tenant               Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classroomId          String
  classroom            Classroom  @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  lessonId             String
  lesson               Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  teacherId            String
  teacher              TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  title                String
  description          String
  attachmentUrls       String[]   @default([])
  dueDate              DateTime
  maxScore             Float      @default(20)
  isGraded             Boolean    @default(true)
  allowLateSubmissions Boolean    @default(false)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  submissions HomeworkSubmission[]

  @@index([tenantId, classroomId, dueDate])
  @@index([tenantId, teacherId])
}

model HomeworkSubmission {
  id             String           @id @default(uuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  homeworkId     String
  homework       Homework         @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId      String
  student        StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content        String?          // یادداشت یا توضیحات دانش‌آموز
  attachmentUrls String[]         @default([])
  submittedAt    DateTime         @default(now())
  status         SubmissionStatus @default(SUBMITTED)
  score          Float?
  feedback       String?          // بازخورد دبیر
  gradedAt       DateTime?
  gradedById     String?
  gradedBy       User?            @relation("GradedSubmission", fields: [gradedById], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([homeworkId, studentId])
  @@index([tenantId, studentId])
}

model SchoolEvent {
  id             String         @id @default(uuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  eventType      EventType      @default(ACADEMIC)
  startDate      DateTime
  endDate        DateTime
  isAllDay       Boolean        @default(false)
  targetAudience TargetAudience @default(ALL)
  targetClassIds String[]       @default([])
  location       String?
  createdById    String
  createdBy      User           @relation("CreatedEvent", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([tenantId, startDate, endDate])
}

model Poll {
  id             String         @id @default(uuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  pollType       PollType       @default(SINGLE_CHOICE)
  targetAudience TargetAudience @default(ALL)
  targetClassIds String[]       @default([])
  startDate      DateTime
  endDate        DateTime
  isAnonymous    Boolean        @default(false)
  isClosed       Boolean        @default(false)
  createdById    String
  createdBy      User           @relation("CreatedPoll", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  options PollOption[]
  votes   PollVote[]

  @@index([tenantId, isClosed])
}

model PollOption {
  id         String   @id @default(uuid())
  pollId     String
  poll       Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text       String
  orderIndex Int      @default(1)
  voteCount  Int      @default(0)

  @@index([pollId])
}

model PollVote {
  id                String   @id @default(uuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pollId            String
  poll              Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  selectedOptionIds String[] @default([])
  ratingValue       Int?
  textResponse      String?
  createdAt         DateTime @default(now())

  @@unique([pollId, userId])
  @@index([tenantId, pollId])
}

model ParentVisitSlot {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacherId       String
  teacher         TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  date            String         // "YYYY-MM-DD"
  startTime       String         // "10:00"
  endTime         String         // "10:20"
  durationMinutes Int            @default(15)
  capacityPerSlot Int            @default(1)
  roomLocation    String?
  isVirtual       Boolean        @default(false)
  virtualMeetingUrl String?
  isCancelled     Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  bookings ParentVisitBooking[]

  @@index([tenantId, teacherId, date])
}

model ParentVisitBooking {
  id           String          @id @default(uuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slotId       String
  slot         ParentVisitSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  parentId     String
  parent       ParentProfile   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject      String          // موضوع جلسه
  status       BookingStatus   @default(CONFIRMED)
  teacherNotes String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([slotId, parentId])
  @@index([tenantId, parentId])
  @@index([tenantId, studentId])
}

model DisciplinaryMatter {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId       String
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYearId  String
  academicYear    AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  type            MatterType     @default(POSITIVE)
  title           String
  description     String
  points          Float          @default(0) // مثبت برای تشویق، منفی برای کسر نمره انضباط
  actionTaken     String?
  reportedById    String
  reportedBy      User           @relation("ReportedMatter", fields: [reportedById], references: [id], onDelete: Cascade)
  reportedAt      DateTime       @default(now())
  notifiedParents Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([tenantId, studentId, type])
  @@index([tenantId, academicYearId])
}

// ==========================================
// PHASE 4: EXAMS & LMS ENGINE
// ==========================================

model LessonPlan {
  id               String         @id @default(uuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId   String
  academicYear     AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  termId           String?
  term             Term?          @relation(fields: [termId], references: [id], onDelete: SetNull)
  lessonId         String
  lesson           Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  teacherId        String
  teacher          TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  title            String         // e.g. "طرح درس جامع سالانه حسابان ۱"
  description      String?
  totalHoursPlanned Int           @default(30)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  sessions LessonPlanSession[]

  @@index([tenantId, lessonId, teacherId])
  @@index([tenantId, academicYearId])
}

model LessonPlanSession {
  id           String                  @id @default(uuid())
  lessonPlanId String
  lessonPlan   LessonPlan              @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  sessionNumber Int                    // جلسه ۱، ۲، ۳...
  topic        String                  // مبحث درس (e.g. "تعریف مشتق و تعبیر هندسی")
  objectives   String?                 // اهداف آموزشی
  activities   String?                 // فعالیت‌های کلاسی و تمرینات
  plannedDate  DateTime?               // تاریخ برنامه‌ریزی‌شده
  actualDate   DateTime?               // تاریخ تدریس واقعی
  status       LessonPlanSessionStatus @default(PLANNED)
  notes        String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@unique([lessonPlanId, sessionNumber])
  @@index([lessonPlanId, status])
}

model QuestionCategory {
  id         String     @id @default(uuid())
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lessonId   String
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  name       String     // e.g. "فصل ۱: توابع و نمودارها"
  orderIndex Int        @default(1)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  questions Question[]

  @@index([tenantId, lessonId])
}

model Question {
  id                  String          @id @default(uuid())
  tenantId            String
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lessonId            String
  lesson              Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  categoryId          String?
  category            QuestionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdById         String
  createdBy           User            @relation("CreatedQuestion", fields: [createdById], references: [id], onDelete: Cascade)
  type                QuestionType    @default(MULTIPLE_CHOICE)
  difficulty          DifficultyLevel @default(MEDIUM)
  text                String          // متن سوال
  formulaHtml         String?
  imageUrls           String[]        @default([])
  defaultScore        Float           @default(1.0)
  suggestedTimeSeconds Int            @default(60)
  solutionExplanation String?         // پاسخ تشریحی و راهنمای تصحیح
  isPublic            Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  options       QuestionOption[]
  examQuestions ExamQuestion[]
  examAnswers   ExamAnswer[]

  @@index([tenantId, lessonId, difficulty])
  @@index([tenantId, type])
}

model QuestionOption {
  id          String   @id @default(uuid())
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text        String
  formulaHtml String?
  imageUrl    String?
  isCorrect   Boolean  @default(false)
  orderIndex  Int      @default(1)

  @@index([questionId])
}

model Exam {
  id                     String     @id @default(uuid())
  tenantId               String
  tenant                 Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId         String
  academicYear           AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  termId                 String?
  term                   Term?      @relation(fields: [termId], references: [id], onDelete: SetNull)
  lessonId               String
  lesson                 Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  teacherId              String
  teacher                TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  title                  String     // e.g. "آزمون میان‌ترم حسابان ۱"
  description            String?
  examType               ExamType   @default(ONLINE)
  durationMinutes        Int        @default(60)
  startTime              DateTime
  endTime                DateTime
  totalScore             Float      @default(20)
  shuffleQuestions       Boolean    @default(true)
  shuffleOptions         Boolean    @default(true)
  allowReview            Boolean    @default(true)
  showResultsImmediately Boolean    @default(false)
  isPublished            Boolean    @default(false)
  status                 ExamStatus @default(DRAFT)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  classrooms     ExamClassroom[]
  questions      ExamQuestion[]
  participations ExamParticipation[]
  gradeEntries   GradeEntry[]

  @@index([tenantId, lessonId, startTime])
  @@index([tenantId, status])
}

model ExamClassroom {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  examId      String
  exam        Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@unique([examId, classroomId])
  @@index([tenantId, classroomId])
}

model ExamQuestion {
  id         String   @id @default(uuid())
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  orderIndex Int
  score      Float    @default(1.0)

  @@unique([examId, questionId])
  @@index([examId, orderIndex])
}

model ExamParticipation {
  id               String              @id @default(uuid())
  tenantId         String
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  examId           String
  exam             Exam                @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId        String
  student          StudentProfile      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  startedAt        DateTime            @default(now())
  submittedAt      DateTime?
  serverDeadline   DateTime            // زمان پایان قطعی سمت سرور
  totalScore       Float?
  isGraded         Boolean             @default(false)
  tabSwitchCount   Int                 @default(0) // شمارنده تعویض تب
  flaggedForReview Boolean             @default(false) // پرچم برای بازبینی معلم
  status           ParticipationStatus @default(IN_PROGRESS)
  questionOrder    String[]            @default([]) // ذخیره قطعی ترتیب سوالات برای این دانش‌آموز
  optionOrders     Json?               // ذخیره قطعی ترتیب گزینه‌های شافل‌شده
  teacherFeedback  String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  answers ExamAnswer[]

  @@unique([examId, studentId])
  @@index([tenantId, studentId])
  @@index([tenantId, examId, status])
}

model ExamAnswer {
  id                String            @id @default(uuid())
  participationId   String
  participation     ExamParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  questionId        String
  question          Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId  String?           // گزینه انتخاب‌شده برای تستی
  descriptiveAnswer String?           // متن پاسخ برای تشریحی
  scoreAwarded      Float?
  isAutoGraded      Boolean           @default(false)
  teacherComment    String?
  submittedAt       DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([participationId, questionId])
  @@index([participationId])
}

model GradeEntry {
  id             String         @id @default(uuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  termId         String?
  term           Term?          @relation(fields: [termId], references: [id], onDelete: SetNull)
  classroomId    String
  classroom      Classroom      @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId      String
  teacher        TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  examId         String?
  exam           Exam?          @relation(fields: [examId], references: [id], onDelete: SetNull)
  gradeType      GradeType      @default(CLASS_ACTIVITY)
  title          String         // e.g. "مستمر آبان‌ماه"
  score          Float          // نمره کسب‌شده
  maxScore       Float          @default(20) // سقف نمره
  weight         Float          @default(1.0)
  date           DateTime       @default(now())
  description    String?
  recordedById   String
  recordedBy     User           @relation("RecordedGrade", fields: [recordedById], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([tenantId, classroomId, lessonId, date])
  @@index([tenantId, studentId, gradeType])
  @@index([tenantId, academicYearId])
}

// ==========================================
// PHASE 5: LIVE COMMUNICATION & CONTENT
// ==========================================

enum MaterialType {
  DOCUMENT
  VIDEO
  AUDIO
  LINK
  ARCHIVE
}

enum ChannelType {
  DIRECT
  CLASS_GROUP
  STAFF_GROUP
  CHANNEL
}

enum MessageAttachmentType {
  IMAGE
  VIDEO
  AUDIO
  FILE
  NONE
}

model CourseMaterial {
  id             String         @id @default(uuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  termId         String?
  term           Term?          @relation(fields: [termId], references: [id], onDelete: SetNull)
  lessonId       String
  lesson         Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  teacherId      String
  teacher        TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  title          String         // e.g. "جزوه دست‌نویس فصل مشتق و مثال‌های تکمیلی"
  description    String?
  materialType   MaterialType   @default(DOCUMENT)
  fileKey        String         // MinIO Object Storage Key
  fileUrl        String         // Public / Presigned Access URL
  fileSizeMb     Float?
  mimeType       String?
  isDownloadable Boolean        @default(true)
  isPublished    Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  classrooms MaterialClassroom[]

  @@index([tenantId, lessonId])
  @@index([tenantId, teacherId])
}

model MaterialClassroom {
  id         String         @id @default(uuid())
  tenantId   String
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  materialId String
  material   CourseMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  classroomId String
  classroom  Classroom      @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@unique([materialId, classroomId])
  @@index([tenantId, classroomId])
}

model ChatChannel {
  id          String      @id @default(uuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        ChannelType @default(DIRECT)
  name        String?     // e.g. "گفتگوی کلاس دهم ریاضی ۱"
  description String?
  classroomId String?
  classroom   Classroom?  @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  members  ChatChannelMember[]
  messages ChatMessage[]

  @@index([tenantId, classroomId])
  @@index([tenantId, type])
}

model ChatChannelMember {
  id         String      @id @default(uuid())
  tenantId   String
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channelId  String
  channel    ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  isAdmin    Boolean     @default(false)
  lastReadAt DateTime?
  joinedAt   DateTime    @default(now())

  @@unique([channelId, userId])
  @@index([tenantId, userId])
}

model ChatMessage {
  id             String                @id @default(uuid())
  tenantId       String
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channelId      String
  channel        ChatChannel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User                  @relation("SentChatMessage", fields: [senderId], references: [id], onDelete: Cascade)
  content        String                // متن پیام
  attachmentKey  String?               // MinIO storage key
  attachmentUrl  String?               // MinIO URL
  attachmentType MessageAttachmentType @default(NONE)
  replyToId      String?
  replyTo        ChatMessage?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        ChatMessage[]         @relation("MessageReplies")
  isDeleted      Boolean               @default(false)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([tenantId, channelId, createdAt])
  @@index([tenantId, senderId])
}

// ==========================================
// PHASE 6: FINANCIAL MANAGEMENT (FEE & PAYROLL)
// ==========================================

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  ONLINE_GATEWAY
  POS_RECEIPT
  BANK_TRANSFER
  CHEQUE
  CASH
}

enum PaymentGateway {
  ZARINPAL
  MANUAL_OFFLINE
  MOCK_SANDBOX
}

enum FeeContractStatus {
  ACTIVE
  COMPLETED
  DEFAULTED
  CANCELLED
}

enum InstallmentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

enum PayrollItemType {
  BASE_SALARY
  HOURLY_TEACHING
  BONUS
  OVERTIME
  INSURANCE_DEDUCTION
  TAX_DEDUCTION
  ADVANCE_DEDUCTION
  OTHER
}

enum ContractType {
  FULL_TIME_SALARY
  HOURLY_TEACHER
  CONTRACTUAL
}

model StudentFeeContract {
  id                 String            @id @default(uuid())
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId     String
  academicYear       AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  studentId          String
  student            StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  contractNumber     String            // e.g. "FEE-1404-001"
  totalAmount        Float             // کل مبلغ مصوب شهریه
  discountAmount     Float             @default(0) // مبلغ تخفیف / بورسیه
  finalPayableAmount Float             // مبلغ نهایی پس از کسر تخفیف
  discountReason     String?
  status             FeeContractStatus @default(ACTIVE)
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  installments FeeInstallment[]
  transactions PaymentTransaction[]
  receipts     FeeReceipt[]

  @@unique([tenantId, contractNumber])
  @@unique([tenantId, academicYearId, studentId])
  @@index([tenantId, status])
}

model FeeInstallment {
  id                String            @id @default(uuid())
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contractId        String
  contract          StudentFeeContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  installmentNumber Int               // قسط ۱، ۲، ۳...
  title             String            // e.g. "پیش‌پرداخت ثبت‌نام", "قسط آبان‌ماه"
  dueDate           DateTime          // تاریخ سررسید قسط
  amount            Float             // مبلغ مصوب قسط
  paidAmount        Float             @default(0) // مبلغ واریزشده
  status            InstallmentStatus @default(UNPAID)
  paidAt            DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  transactions PaymentTransaction[]

  @@unique([contractId, installmentNumber])
  @@index([tenantId, status, dueDate])
}

model PaymentTransaction {
  id                     String         @id @default(uuid())
  tenantId               String
  tenant                 Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contractId             String?
  contract               StudentFeeContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  installmentId          String?
  installment            FeeInstallment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  payerUserId            String
  payer                  User           @relation("PayerTransactions", fields: [payerUserId], references: [id], onDelete: Cascade)
  gateway                PaymentGateway @default(ZARINPAL)
  method                 PaymentMethod  @default(ONLINE_GATEWAY)
  amount                 Float          // مبلغ پرداختی (ریال یا تومان طبق استاندارد سیستم)
  status                 PaymentStatus  @default(PENDING)
  authority              String?        // کد پیگیری درگاه پرداخت زرین‌پال
  refId                  String?        // شماره مرجع / تراکنش بانکی زرین‌پال
  trackingCode           String         // کد پیگیری یکتای داخلی رُکاد
  cardPan                String?        // شماره کارت ماسک‌شده پرداخت‌کننده
  ipAddress              String?
  gatewayRequestPayload  Json?
  gatewayResponsePayload Json?
  errorMessage           String?
  verifiedAt             DateTime?
  idempotencyKey         String?
  createdAt              DateTime       @default(now())

  receipt FeeReceipt?

  @@unique([tenantId, trackingCode])
  @@index([tenantId, authority])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, payerUserId])
}

model FeeReceipt {
  id            String             @id @default(uuid())
  tenantId      String
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId String             @unique
  transaction   PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  contractId    String
  contract      StudentFeeContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  receiptNumber String             // e.g. "REC-1404-0012"
  amount        Float
  payerName     String
  paymentMethod PaymentMethod      @default(ONLINE_GATEWAY)
  issuedAt      DateTime           @default(now())
  issuedById    String?
  issuedBy      User?              @relation("IssuedFeeReceipts", fields: [issuedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, receiptNumber])
  @@index([tenantId, contractId])
  @@index([tenantId, issuedAt])
}

model StaffPayrollProfile {
  id                 String       @id @default(uuid())
  tenantId           String
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId             String       @unique
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  contractType       ContractType @default(FULL_TIME_SALARY)
  baseMonthlySalary  Float        @default(0) // حقوق ثابت ماهیانه
  hourlyRate         Float        @default(0) // نرخ تدریس هر ساعت برای دبیران حق‌التدریس
  bankAccountNumber  String?      // شماره حساب بانکی
  bankShebaNumber    String?      // شماره شبا
  bankName           String?      // نام بانک (ملی، ملت، پاسارگاد...)
  insuranceNumber    String?      // شماره بیمه تأمین اجتماعی
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([tenantId, isActive])
}

model PayrollSlip {
  id               String        @id @default(uuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId           String
  user             User          @relation("EmployeePayrollSlips", fields: [userId], references: [id], onDelete: Cascade)
  year             Int           // سال e.g. 1404
  month            Int           // ماه e.g. 1..12
  slipNumber       String        // e.g. "PAY-1404-08-01"
  grossPay         Float         // جمع ناخالص حقوق و مزایا
  totalDeductions  Float         @default(0) // جمع کسورات (بیمه، مالیات، مساعده)
  netPay           Float         // خالص پرداختی
  status           PayrollStatus @default(DRAFT)
  paidAt           DateTime?
  paidById         String?
  paidBy           User?         @relation("ApprovedPayrollSlips", fields: [paidById], references: [id], onDelete: SetNull)
  paymentRefNumber String?       // شماره پیگیری انتقال وجه بانکی / پایا
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  items PayrollItem[]

  @@unique([tenantId, userId, year, month])
  @@unique([tenantId, slipNumber])
  @@index([tenantId, status])
  @@index([tenantId, year, month])
}

model PayrollItem {
  id                String          @id @default(uuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollSlipId     String
  payrollSlip       PayrollSlip     @relation(fields: [payrollSlipId], references: [id], onDelete: Cascade)
  type              PayrollItemType @default(BASE_SALARY)
  title             String          // e.g. "حقوق پایه ماهیانه", "حق‌التدریس ۳۰ ساعت حسابان", "کسر بیمه سهم کارمند"
  amount            Float           // مبلغ مثبت برای مزایا و منفی برای کسورات
  multiplierOrHours Float?          // ضریب یا تعداد ساعت
  notes             String?

  @@index([tenantId, payrollSlipId])
}
